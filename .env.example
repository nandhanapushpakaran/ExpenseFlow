# Application Environment (development, testing, production)
ENVIRONMENT=development
PROJECT_NAME="Expense Tracker Dashboard"
API_V1_STR=/api/v1

# Database Configuration
# Default PostgreSQL connection:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/expense_tracker
# For SQLite fallback during rapid local development without PostgreSQL running:
# DATABASE_URL=sqlite:///./expense_tracker.db

# Authentication & Security
# Generate a secure key in production with: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_secret_key_minimum_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (comma-separated list)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Environment Variables (Vite reads variables prefixed with VITE_)
VITE_API_URL=http://localhost:8000/api/v1
